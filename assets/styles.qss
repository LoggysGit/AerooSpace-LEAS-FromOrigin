/* Общий фон окна */
QMainWindow {
    background-color: #0d0d0d;
}

/* Все кнопки */
QPushButton {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 14px;
}

/* Эффект при наведении */
QPushButton:hover {
    background-color: #333;
    border: 1px solid #0055ff;
}

/* Обращение к конкретной кнопке по ObjectName */
QPushButton#mainButton {
    background-color: #0055ff;
    font-weight: bold;
}

/* Поля ввода */
QLineEdit {
    background-color: #1a1a1a;
    color: white;
    border-radius: 5px;
    padding: 5px;
}